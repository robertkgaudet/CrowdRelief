<%@ Master Language="C#" AutoEventWireup="true" CodeFile="SecureOrganization.master.cs" Inherits="Account_MasterPages_SecureOrganization" %>

<%@ Register Src="~/Account/UserControls/SecureHeader.ascx" TagPrefix="uc1" TagName="Header" %>
<%@ Register Src="~/Account/UserControls/Footer.ascx" TagPrefix="uc1" TagName="Footer" %>
<%@ Register Src="~/Account/UserControls/NavigationOrganization.ascx" TagPrefix="uc1" TagName="NavigationOrganization" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<meta http-equiv="X-UA-Compatible" content="IE=edge"/>

		<!-- Page title -->
		<title>CrowdRelief - Community-led Recovery</title>

		<meta id="fbimage" property="og:image" runat="server"/>
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:title" id="fbtitle" runat="server"/> 
		<meta property="og:url" id="fburl" runat="server"/>
		<meta property="og:site_name" content="CrowdRelief - Crowdfunding household items for Louisiana flood victims"/>

		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5" />
		<meta name="theme-color" content="#ffffff" />

		<!-- Place favicon.ico and apple-touch-icon.png in the root directory -->
		<!--<link rel="shortcut icon" type="image/ico" href="favicon.ico" />-->

		<!-- Vendor styles -->
		<link rel="stylesheet" href="/Scripts/vendor/fontawesome/css/font-awesome.css" />
		<link rel="stylesheet" href="/Scripts/vendor/metisMenu/dist/metisMenu.css" />
		<link rel="stylesheet" href="/Scripts/vendor/animate.css/animate.css" />
		<link rel="stylesheet" href="/Scripts/vendor/bootstrap/dist/css/bootstrap.css" />

		<!-- App styles -->
		<link rel="stylesheet" href="/fonts/pe-icon-7-stroke/css/pe-icon-7-stroke.css" />
		<link rel="stylesheet" href="/fonts/pe-icon-7-stroke/css/helper.css" />
		<link rel="stylesheet" href="/styles/style.css">

		<!-- Vendor scripts -->
		<script src="/Scripts/vendor/jquery/dist/jquery.min.js"></script>
		<script src="/Scripts/vendor/slimScroll/jquery.slimscroll.min.js"></script>
		<script src="/Scripts/vendor/bootstrap/dist/js/bootstrap.min.js"></script>
		<script src="/Scripts/vendor/metisMenu/dist/metisMenu.min.js"></script>

		<!-- App scripts -->
		<script src="/scripts/homer.js"></script>

		<asp:ContentPlaceHolder ID="HeadContentPlaceHolder" runat="server" />

		<style>
			.logo:hover{
				cursor:pointer;
			}
			.navbar-nav>li>a:hover,.navbar-nav>li>a:focus,.navbar-nav .open>a,.navbar-nav .open>a:hover,.navbar-nav .open>a:focus
			{
				background:#62CB31;
				color:#FFFFFF;
			}

			.navbar-nav li a:hover {
				color:#62CB31;
				color:#FFFFFF;
			}

			.navbar-nav>li>a{
				font-size: 14px;
				color:#62CB31;
				padding:20px 10px;
			}

			a:link {
				color:#62CB31;
			}

		</style>

	
	</head>
	<body class="light-skin fixed-navbar sidebar-scroll">
		<form id="form1" runat="server">

			<uc1:Header runat="server" ID="Header" />

			<uc1:NavigationOrganization runat="server" ID="NavigationOrganization" />

			<asp:ContentPlaceHolder ID="BodyContentPlaceHolder1" runat="server" />
	
			<!-- Footer -->
			<uc1:Footer runat="server" ID="Footer" />
		</form>
	</body>
</html>
